# Copy to backend/.env and fill required values privately. Never commit .env.
# All values below are examples; no service credentials are included.
# Read backend/README.md for provider permissions and activation steps.

# Local API and frontend. For a combined production deployment, set
# SERVE_FRONTEND=true and FRONTEND_ORIGIN to the actual HTTPS site origin.
PORT=3003
SERVE_FRONTEND=false
FRONTEND_ORIGIN=http://localhost:5173
# Used by S3 photo URLs and Twilio callbacks; use your HTTPS API origin when hosted.
# No trailing slash or /api suffix.
PUBLIC_API_URL=http://localhost:3003

# Required: PostgreSQL connection. This is a local example, not a working password.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/campusmesh
DATABASE_SSL=false
# For Supabase, paste the connection string from Connect > Session pooler,
# URL-encode special characters in its password, and set DATABASE_SSL=true.
# Run npm run db:migrate from backend/ before starting the API.

# Required: generate a unique secret, for example with openssl rand -hex 32.
# Keep the same value across backend instances; changing it invalidates tokens.
JWT_SECRET=

# OTP email: choose smtp, ses, or lambda. Signup accepts @dbit.co.in only.
# smtp uses Gmail and requires outbound SMTP; fill EMAIL_USER and EMAIL_PASS.
# For Render Free use a configured lambda or ses provider over HTTPS.
EMAIL_PROVIDER=smtp
EMAIL_USER=
# Gmail app password (not your normal account password).
EMAIL_PASS=
# ses only: sender verified in AWS_REGION. SES sandbox restricts recipients.
EMAIL_FROM=
# lambda only: deployed private function name/ARN in AWS_REGION.
# Set EMAIL_USER and EMAIL_PASS on the function itself, not this backend.
EMAIL_LAMBDA_FUNCTION=

# AWS SDK credentials for the selected mail provider and/or S3 photos.
# Leave key fields blank when using an IAM role or local AWS credential profile.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only with temporary AWS credentials.
AWS_SESSION_TOKEN=

# Private S3 bucket for listing and required handover condition photos.
# PUBLIC_API_URL is also required. The runtime IAM identity needs PutObject,
# GetObject and DeleteObject on both listings/* and handovers/* in this bucket.
# Handover photos use participant-only APIs and five-minute signed URLs.
# S3_REGION defaults to AWS_REGION when blank. Keep public bucket access blocked.
S3_PHOTO_BUCKET=
S3_REGION=

# Optional: private PDF storage for the future Print/Xerox module.
# The normal marketplace uses DATABASE_URL, not a Supabase browser client.
# Never expose the service-role key in frontend/VITE_ variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_XEROX_BUCKET=xerox-private
XEROX_RETENTION_DAYS=7

# Optional: matching Razorpay key pair. Use your own rzp_test_ keys for testing.
# Leave blank to keep online payment unconfigured. No money is collected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate signing secret configured on Razorpay Dashboard > Webhooks.
# Endpoint: https://YOUR_HOST/api/payment/webhook (raw JSON HMAC verification).
RAZORPAY_WEBHOOK_SECRET=

# Optional grounded support AI. Leave blank to use the built-in help library.
# Select a Responses API model supporting structured outputs in your project.
OPENAI_API_KEY=
OPENAI_MODEL=

# Calling stays in preview; saving preferences or playing audio does not dial.
# Choose authkey or twilio. Provider credentials alone never enable live calls.
CALLS_PROVIDER=authkey
CALLS_MODE=preview
CALLS_SCHEDULER_ENABLED=false

# Authkey: approved Voice access and usable credits are required before live mode.
# Keep approval false while activation/free-credit approval is pending.
AUTHKEY_API_KEY=
AUTHKEY_VOICE_APPROVED=false
# Numeric ID of your approved Voice OTP template containing {#2fa#}.
AUTHKEY_OTP_TEMPLATE_ID=
# Optional numeric ID of an approved template containing {#message#}.
# Template language/voice are selected in Authkey (English India / Female).
AUTHKEY_VOICE_TEMPLATE_ID=

# Twilio alternative: fill only when CALLS_PROVIDER=twilio.
# FROM_NUMBER must be your Twilio voice-capable number in +country-code format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio Verify is used for user-requested phone verification by SMS.
TWILIO_VERIFY_SERVICE_SID=
# Set true only for a trial account; provider destination restrictions still apply.
TWILIO_TRIAL_MODE=false

# Optional private external scheduler: unique random token of at least 32 chars.
# Installing a scheduler is a separate step; these values do not install one.
CALLS_SCHEDULER_SECRET=
# Optional HTTPS origin override for install-call-scheduler.js;
# falls back to PUBLIC_API_URL when blank.
CALLS_SCHEDULER_API_URL=

# Marketplace bank payouts. Leave disabled until Razorpay approves Route for
# this business and its funding/settlement schedule. Live collection is blocked
# for recipients who have not completed payout verification.
PAYOUTS_ENABLED=false
RAZORPAY_ROUTE_APPROVED=false
# Independent authenticated cron endpoint: POST /api/payout-scheduler/tick
PAYOUTS_SCHEDULER_SECRET=

# New rentals use separate UPI payments confirmed manually by each recipient.
DIRECT_UPI_ENABLED=true
