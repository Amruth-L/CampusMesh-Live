# Copy to frontend/.env for local use. VITE_ values are public in browser builds.
# Never add JWT secrets, database URLs, AWS keys or provider secret keys here.

# API origin, without a trailing slash or /api suffix.
# Leave blank for localhost:3003 in development and same-origin in production.
# For separate frontend/backend hosting, set this to your HTTPS backend origin.
VITE_API_BASE_URL=
# Optional legacy alias; if set, VITE_API_URL takes precedence over the value above.
# VITE_API_URL=

# Optional public Razorpay Key ID only. Match the backend's test/live key pair.
# Checkout normally receives the key ID from the backend order response.
# Never put RAZORPAY_KEY_SECRET here. Do not use a real card in test mode.
VITE_RAZORPAY_KEY_ID=

# Vite reads these at build time. Restart the dev server or rebuild after changes.
